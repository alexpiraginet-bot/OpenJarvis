# Jarvis — Life OS: the client-facing assistant, on its own.
#
# The main Dockerfile builds the research server: Rust extension, inference
# engines, telemetry, the whole framework. A client's phone talks to none of
# that. This image carries the Life API and the PWA and nothing else, which
# makes it start in a second, run comfortably on the smallest instance a host
# will sell, and present a far smaller surface to secure.
#
# Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.life -t jarvis-life .
#
# Base images are pinned by digest, matching the convention in ./Dockerfile —
# reproducible builds and safe rollbacks.

# Stage 1: the PWA
FROM node:22.23.0-slim@sha256:d9f850096136edbc402debdd8729579a288aac64574ada0ff4db26b6ae58b0b2 AS frontend

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --ignore-scripts 2>/dev/null || npm install
COPY frontend/ .
# Vite writes to ../src/openjarvis/server/static (see vite.config.ts), so the
# output lands outside /frontend — copied explicitly in the final stage.
RUN npm run build

# Stage 2: runtime
FROM python:3.12.13-slim-bookworm@sha256:76d4b7b6305788c6b4c6a19d6a22a3921bf802e9af4d5e1e5bd771208dba74bf

# Only the server extra. No inference engines, no Rust toolchain: the Life app
# needs FastAPI, uvicorn and pydantic, all of which ship wheels.
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN pip install --no-cache-dir uv && \
    uv export --frozen --no-dev --extra server --no-emit-project > requirements.txt && \
    uv pip install --system --no-deps -r requirements.txt && \
    rm requirements.txt

COPY src/ ./src/
COPY --from=frontend /src/openjarvis/server/static ./src/openjarvis/server/static

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    OPENJARVIS_LIFE_HOST=0.0.0.0 \
    OPENJARVIS_LIFE_PORT=8100 \
    OPENJARVIS_LIFE_DB=/data/life.db

# The database is the client's entire financial and family history. It lives on
# a mounted volume, never in the image layer — a redeploy must not wipe it.
VOLUME ["/data"]
RUN mkdir -p /data

# Run as a non-root user: a web-facing process has no business owning the
# filesystem it serves from.
RUN useradd --create-home --uid 10001 jarvis && chown -R jarvis /data
USER jarvis

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8100/health', timeout=4).status==200 else 1)"

CMD ["python", "-m", "openjarvis.life.server"]
